{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@shared/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "web/src/lib/calendar.ts",
    "web/src/lib/events.ts",
    "web/src/lib/personalize.ts",
    "web/src/lib/dates.ts",
    "web/src/lib/search.ts",
    "web/src/lib/searchSync.ts"
  ]
}
